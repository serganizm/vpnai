#!/usr/bin/python3
import sys,pathlib,json,secrets,hashlib,subprocess,os,re,socket,fcntl
os.umask(0o077)
lock=open('/run/ovpn-user.lock','w');fcntl.flock(lock,fcntl.LOCK_EX)
base=pathlib.Path('/etc/openvpn/server');db=base/'users.json';users=json.loads(db.read_text())
cmd=sys.argv[1] if len(sys.argv)>1 else 'list';name=sys.argv[2] if len(sys.argv)>2 else ''
def rsa(*args):
 env=dict(os.environ,EASYRSA_PKI=str(base/'pki'),EASYRSA_BATCH='1',EASYRSA_ALGO='ec',EASYRSA_CURVE='prime256v1')
 subprocess.run(['/usr/share/easy-rsa/easyrsa',*args],env=env,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
def save():
 tmp=base/'users.tmp';tmp.write_text(json.dumps(users,indent=2));tmp.chmod(0o600);tmp.replace(db)
def create_profiles(name):
 profile="""client
proto udp4
dev tun
remote @@RU_IP@@ @@OVPN_PORT@@
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name ru-server name
auth-user-pass
tls-version-min 1.2
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
tun-mtu 1360
mssfix 1320
verb 3
"""
 for tag,p in [('ca',base/'pki/ca.crt'),('cert',base/('pki/issued/'+name+'.crt')),('key',base/('pki/private/'+name+'.key')),('tls-crypt',base/'tls-crypt.key')]:profile+='\n<'+tag+'>\n'+p.read_text()+'\n</'+tag+'>\n'
 out=pathlib.Path('/root/ovpn-profiles');out.mkdir(mode=0o700,exist_ok=True)
 (out/(name+'.ovpn')).write_text(profile)
 (out/(name+'-UDP.ovpn')).write_text(profile)
 tcp=profile.replace('proto udp4','proto tcp4-client')
 (out/(name+'-TCP.ovpn')).write_text(tcp)
 return out

def disconnect(name):
 ok=True
 for path in ('/run/openvpn-server/ru-management.sock','/run/openvpn-server/ru-tcp-management.sock'):
  if not pathlib.Path(path).exists():continue
  try:
   conn=socket.socket(socket.AF_UNIX);conn.settimeout(3);conn.connect(path);conn.recv(4096);conn.sendall(('kill '+name+'\n').encode());conn.recv(4096);conn.close()
  except OSError:ok=False
 return ok

if cmd=='list':
 for n,v in users.items():print(n,'deleted' if v.get('deleted') else ('enabled' if v['enabled'] else 'revoked'))
 sys.exit()
if not re.fullmatch('[a-zA-Z0-9_-]{1,48}',name):sys.exit('Invalid username')
if cmd=='add':
 if name in users and users[name].get('enabled'):
  sys.exit('User is already active; change the password or delete the user first')
 if name in users:
  # Keep OpenSSL's revoked serial history. Never reissue over an unrevoked certificate.
  for row in (base/'pki/index.txt').read_text().splitlines():
   fields=row.split('\t')
   if len(fields)>=6 and fields[0]=='V' and fields[-1]=='/CN='+name:
    sys.exit('An unrevoked certificate remains; revoke it before reusing this name')

 comment=sys.argv[sys.argv.index('--comment')+1] if '--comment' in sys.argv and sys.argv.index('--comment')+1<len(sys.argv) else ''
 if len(comment)>200 or any(ord(c)<32 or ord(c)==127 for c in comment):sys.exit('Комментарий: не более 200 символов, без управляющих символов')
 rsa('build-client-full',name,'nopass')
 password=secrets.token_urlsafe(24);salt=secrets.token_hex(16)
 users[name]={'enabled':True,'comment':comment,'salt':salt,'hash':hashlib.pbkdf2_hmac('sha256',password.encode(),bytes.fromhex(salt),300000).hex()};save()
 out=create_profiles(name)
 (out/(name+'-credentials.txt')).write_text('Login: '+name+'\nPassword: '+password+'\nServer: @@RU_IP@@:@@OVPN_PORT@@ UDP and TCP\nSimultaneous connections with this profile: allowed (duplicate-cn)\n')
 print('Created: '+str(out/(name+'.ovpn'))+' and credentials file (mode 600).')
elif cmd=='profiles':
 if name not in users or not users[name].get('enabled'):sys.exit('Unknown or inactive user')
 create_profiles(name)
 print('UDP and TCP profiles created; password and certificate unchanged.')
elif cmd=='passwd':
 if name not in users or not users[name].get('enabled'):
  sys.exit('Unknown or disabled user')
 if '--auto' in sys.argv[3:]:password=secrets.token_urlsafe(24)
 else:
  import getpass
  password=getpass.getpass('New password: ') if sys.stdin.isatty() else sys.stdin.readline().rstrip('\n')
  if not 8<=len(password)<=256 or any(c in password for c in '\r\n\x00'):
   sys.exit('Password must contain 8 to 256 characters, without line breaks')
 salt=secrets.token_hex(16)
 users[name]['salt']=salt
 users[name]['hash']=hashlib.pbkdf2_hmac('sha256',password.encode(),bytes.fromhex(salt),300000).hex()
 save()
 out=pathlib.Path('/root/ovpn-profiles');out.mkdir(mode=0o700,exist_ok=True)
 f=out/(name+'-credentials.txt')
 tmp=out/(name+'-credentials.tmp')
 tmp.write_text('Login: '+name+'\nPassword: '+password+'\nServer: @@RU_IP@@:@@OVPN_PORT@@ UDP and TCP\nSimultaneous connections with this profile: allowed (duplicate-cn)\n')
 tmp.chmod(0o600);tmp.replace(f)
 if not disconnect(name):print('WARNING: some active sessions could not be disconnected.')
 print('Password updated; profile unchanged. Credentials: '+str(f))
elif cmd in ('revoke','delete'):
 if name not in users:sys.exit('Unknown user')
 was_enabled=users[name].get('enabled',False)
 users[name]['enabled']=False;save()
 subprocess.run(['/usr/local/sbin/ovpn-link','invalidate',name],check=True,stdout=subprocess.DEVNULL)
 if was_enabled:rsa('revoke',name)
 rsa('gen-crl')
 # Kill every active session with the certificate CN using the management socket.
 if not disconnect(name):print('WARNING: some active sessions could not be disconnected.')
 if cmd=='delete':
  for suffix in ('.ovpn','-UDP.ovpn','-TCP.ovpn','-credentials.txt'):
   (pathlib.Path('/root/ovpn-profiles')/(name+suffix)).unlink(missing_ok=True)
  users[name]['deleted']=True;save()
 print(('Deleted ' if cmd=='delete' else 'Revoked ')+name)
else:sys.exit('Use: ovpn-user add NAME | list | passwd NAME [--auto] | revoke NAME | delete NAME')
