[Unit]
Description=Temporary OpenVPN profile download links
After=network.target
[Service]
User=ovpn-links
Group=ovpn-links
ExecStart=/usr/bin/python3 /usr/local/libexec/ovpn-link-server.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
[Install]
WantedBy=multi-user.target
