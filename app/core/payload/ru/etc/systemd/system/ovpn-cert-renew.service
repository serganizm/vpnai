[Unit]
Description=Renew IP HTTPS certificate through protected NL relay
After=network-online.target nginx.service ovpn-network.service strongswan.service
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/ovpn-cert-manage.py renew
TimeoutStartSec=12min
UMask=0077
