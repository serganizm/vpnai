server {
 listen 80;
 server_name @@RU_IP@@;
 access_log off;
 error_log /var/log/nginx/ovpn-links-error.log crit;
 location ^~ /.well-known/acme-challenge/ { root /var/www/ovpn-acme; }
 location / { return 404; }
}
server {
 listen 443 ssl;
 server_name @@RU_IP@@;
 ssl_certificate /etc/letsencrypt/live/ovpn-links/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/ovpn-links/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 access_log off;
 error_log /var/log/nginx/ovpn-links-error.log crit;
 client_max_body_size 1k;
 location /d/ {
  limit_req zone=ovpn_link_limit burst=20 nodelay;
  proxy_pass http://127.0.0.1:8765;
  proxy_set_header Host $host;
  proxy_connect_timeout 3s;
  proxy_read_timeout 10s;
 }
 location / { return 404; }
}
